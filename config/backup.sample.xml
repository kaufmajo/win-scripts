<!--
  Config for Backup.ps1 - copy to backup.xml and adjust.
  Counterpart: linux_scripts/config/backup.conf (same drive settings).
-->
<settings>

  <!-- Backup drives
       letter     Windows drive letter
       label      Volume label (safety check: the drive is only used if it matches)
       bitlocker  true: unlock with <unlockDrive> if the drive is locked
       envvar     Name of the variable holding the BitLocker password (read by <unlockDrive>) -->

  <masterdrive>
    <letter>X</letter>
    <label>masterdrive</label>
    <bitlocker>true</bitlocker>
    <envvar>master_password_env</envvar>
  </masterdrive>

  <slavedrive>
    <letter>Y</letter>
    <label>slavedrive</label>
    <bitlocker>true</bitlocker>
    <envvar>slave_password_env</envvar>
  </slavedrive>

  <!-- Folders
       rootfolder          Folder to back up
       targetFolder        Mirror goes to X:\<COMPUTERNAME>\<targetFolder>\<USERNAME>\
       configFolder        Copies of the <config> paths (rebuilt on every run, must be inside rootfolder)
       wslExportFolder     Target of -ExportWsl
       hyperVPoolFolder    Hyper-V VM files, excluded from the mirror
       hyperVExportFolder  Target of -ExportHyperV -->

  <folder>
    <rootfolder>C:\path\to\root\</rootfolder>
    <targetFolder>win</targetFolder>
    <configFolder>C:\path\to\root\___Config\</configFolder>
    <wslExportFolder>C:\path\to\root\wsl-export\</wslExportFolder>
    <hyperVPoolFolder>C:\path\to\root\hyperv-pool\</hyperVPoolFolder>
    <hyperVExportFolder>C:\path\to\root\hyperv-export\</hyperVExportFolder>
  </folder>

  <!-- Number of history folders kept per backup drive -->
  <historyKeep>30</historyKeep>

  <!-- Script that unlocks BitLocker drives -->
  <script>
    <unlockDrive>C:\path\to\win_scripts\Enable-BitlockerDrive.ps1</unlockDrive>
  </script>

  <!-- WSL backup, started with -WithLinux -->
  <linux>
    <distribution>Debian</distribution>
    <script>/home/user/path/to/linux_scripts/backup.sh</script>
  </linux>

  <!-- Config files outside rootfolder, copied to <configFolder> on every backup.
       The full path is kept: C:\Users\me\.gitconfig -> <configFolder>\C\Users\me\.gitconfig
       A path can be a file or a folder. -->
  <config>
    <path>C:\Users\username\.gitconfig</path>
    <path>C:\Users\username\AppData\Local\nvim</path>
  </config>

  <!-- WSL distributions, exported with -ExportWsl to <wslExportFolder>\<name>.tar -->
  <wslExport>
    <job>
      <name>Debian</name>
    </job>
  </wslExport>

  <!-- Hyper-V VMs, exported with -ExportHyperV to <hyperVExportFolder>\<name>\ -->
  <hyperVExport>
    <job>
      <name>vm_name</name>
    </job>
  </hyperVExport>

</settings>
